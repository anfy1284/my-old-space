{
    "app": {
        "caption": {
            "i18n": "settings_app_core"
        },
        "icon": "/apps/general_icons/resources/public/16x16/settings.png",
        "order": 10
    },
    "settings": {
        "language": {
            "scope": "user",
            "type": "reference",
            "reference": {
                "table": "languages",
                "displayField": "name"
            },
            "caption": {
                "i18n": "settings_core_language"
            },
            "default": null,
            "order": 10
        },
        "adminEditsClosedDocuments": {
            "//": "Снимает с администратора замок выставленных документов (drive_root/db/immutable.js#adminOverride). Решение владельца 13.09.2026.",
            "scope": "system",
            "type": "boolean",
            "default": false,
            "visibility": "admin",
            "group": {
                "i18n": "settings_core_group_documents"
            },
            "caption": {
                "i18n": "settings_core_admin_edits_closed_docs"
            },
            "hint": {
                "i18n": "settings_core_admin_edits_closed_docs_hint"
            },
            "order": 100
        },
        "closingDate": {
            "//": "Дата запрета редактирования (ТЗ §13). Документы с датой НЕ ПОЗЖЕ этой (день включительно) не меняются и не удаляются. Выставленная РУКАМИ — это настоящее закрытие периода, по которому отчитались; автосдвиг её назад не возвращает. Уровень — организация; резолвер один (drive_root/db/closingDate.js#configFor).",
            "scope": "organization",
            "type": "date",
            "default": null,
            "group": {
                "i18n": "settings_core_group_closing"
            },
            "caption": {
                "i18n": "settings_core_closing_date"
            },
            "hint": {
                "i18n": "settings_core_closing_date_hint"
            },
            "order": 200
        },
        "closingAuto": {
            "//": "Двигать дату запрета автоматически — задачей core.advanceClosingDate (скользящее окно постоянной длины). Выключено ПОЛНОСТЬЮ по умолчанию: механизм нужен не всем, а выставленная руками дата действует и без него.",
            "scope": "organization",
            "type": "boolean",
            "default": false,
            "group": {
                "i18n": "settings_core_group_closing"
            },
            "caption": {
                "i18n": "settings_core_closing_auto"
            },
            "hint": {
                "i18n": "settings_core_closing_auto_hint"
            },
            "order": 210
        },
        "closingOffsetDays": {
            "//": "Длина окна свободной правки, в днях. Дата запрета при автосдвиге = сегодня минус это число, конец суток: сегодня 15 октября при значении 30 — закрыто по 15 сентября включительно. Окно ПОСТОЯННОЙ длины, а не «до конца прошлого месяца»: месячная граница даёт 27-го почти месяц свободы, а 1-го — ноль.",
            "scope": "organization",
            "type": "number",
            "default": 30,
            "group": {
                "i18n": "settings_core_group_closing"
            },
            "caption": {
                "i18n": "settings_core_closing_window"
            },
            "hint": {
                "i18n": "settings_core_closing_window_hint"
            },
            "order": 220
        },
        "postingRetryThreshold": {
            "//": "Сколько неудач подряд пробуем на КАЖДОМ проходе очереди, прежде чем разредить повторы (ТЗ §10.4, §15).",
            "scope": "system",
            "type": "number",
            "default": 3,
            "visibility": "admin",
            "group": {
                "i18n": "settings_core_group_posting"
            },
            "caption": {
                "i18n": "settings_core_posting_retry_threshold"
            },
            "hint": {
                "i18n": "settings_core_posting_retry_threshold_hint"
            },
            "order": 300
        },
        "postingRetryDelayMinutes": {
            "//": "Через сколько минут пробовать проведение после превышения порога неудач.",
            "scope": "system",
            "type": "number",
            "default": 5,
            "visibility": "admin",
            "group": {
                "i18n": "settings_core_group_posting"
            },
            "caption": {
                "i18n": "settings_core_posting_retry_delay"
            },
            "hint": {
                "i18n": "settings_core_posting_retry_delay_hint"
            },
            "order": 310
        },
        "postingSweepMinutes": {
            "//": "Период страхующего запуска исполнителя очереди. Обычный путь — толчок сразу после постановки; это на случай, когда процесс упал между записью строки и толчком.",
            "scope": "system",
            "type": "number",
            "default": 5,
            "visibility": "admin",
            "group": {
                "i18n": "settings_core_group_posting"
            },
            "caption": {
                "i18n": "settings_core_posting_sweep"
            },
            "hint": {
                "i18n": "settings_core_posting_sweep_hint"
            },
            "order": 320
        },
        "postingSuccessNotifyTtl": {
            "//": "Через сколько секунд гаснет уведомление об успешном проведении. Успех — эфемерный и с тайм-аутом, ошибка — с записью и без (ТЗ §12.1).",
            "scope": "system",
            "type": "number",
            "default": 10,
            "visibility": "admin",
            "group": {
                "i18n": "settings_core_group_posting"
            },
            "caption": {
                "i18n": "settings_core_posting_success_ttl"
            },
            "hint": {
                "i18n": "settings_core_posting_success_ttl_hint"
            },
            "order": 330
        }
    }
}
