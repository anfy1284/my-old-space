{
    "models": [
        {
            "name": "MessengerChats",
            "tableName": "messenger_chats",
            "fields": {
                "userId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "users", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_chat_owner_field" }
                },
                "name": {
                    "type": "STRING",
                    "allowNull": false,
                    "translatable": true,
                    "caption": { "i18n": "msg_chat_name_field" }
                },
                "kind": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "private",
                    "caption": { "i18n": "msg_chat_kind_field" },
                    "inputType": "emunList",
                    "options": [
                        { "value": "private", "caption": { "i18n": "msg_chat_kind_private" } },
                        { "value": "group", "caption": { "i18n": "msg_chat_kind_group" } }
                    ]
                },
                "description": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "msg_chat_description_field" }
                },
                "isActive": {
                    "type": "BOOLEAN",
                    "allowNull": false,
                    "defaultValue": true,
                    "caption": { "i18n": "msg_chat_active_field" }
                },
                "lastMessageAt": {
                    "type": "DATE",
                    "allowNull": true,
                    "caption": { "i18n": "msg_chat_last_message_field" }
                }
            },
            "options": {
                "timestamps": true,
                "indexes": [
                    { "fields": ["lastMessageAt"] }
                ]
            }
        },
        {
            "name": "MessengerChatMembers",
            "tableName": "messenger_chat_members",
            "fields": {
                "chatId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "messenger_chats", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_member_chat_field" }
                },
                "userId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "users", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_member_user_field" }
                },
                "role": {
                    "type": "STRING",
                    "allowNull": false,
                    "defaultValue": "member",
                    "caption": { "i18n": "msg_member_role_field" }
                },
                "customName": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "msg_member_custom_name_field" }
                },
                "outgoingLanguageId": {
                    "type": "STRING",
                    "allowNull": true,
                    "references": { "model": "languages", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "SET NULL",
                    "caption": { "i18n": "msg_member_outgoing_language_field" }
                },
                "joinedAt": {
                    "type": "DATE",
                    "allowNull": true,
                    "caption": { "i18n": "msg_member_joined_field" }
                },
                "isActive": {
                    "type": "BOOLEAN",
                    "allowNull": false,
                    "defaultValue": true,
                    "caption": { "i18n": "msg_member_active_field" }
                }
            },
            "options": {
                "timestamps": true,
                "indexes": [
                    { "unique": true, "fields": ["chatId", "userId"] }
                ]
            }
        },
        {
            "name": "MessengerMessages",
            "tableName": "messenger_messages",
            "fields": {
                "chatId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "messenger_chats", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_message_chat_field" }
                },
                "userId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "users", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_message_author_field" }
                },
                "content": {
                    "//": "Текст, КАК ОН УШЁЛ. Для получателя это и есть сообщение: если отправитель послал перевод, здесь лежит перевод, и никакой пометки о переводе получателю не полагается.",
                    "type": "TEXT",
                    "allowNull": true,
                    "caption": { "i18n": "msg_message_content_field" }
                },
                "originalContent": {
                    "//": "Что автор НАБРАЛ, если сообщение ушло переведённым. Только для автора: свои сообщения человек должен видеть на том языке, на котором их писал. Получателю не отдаётся никогда.",
                    "type": "TEXT",
                    "allowNull": true,
                    "caption": { "i18n": "msg_message_original_field" }
                },
                "clientMsgId": {
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "msg_message_client_id_field" }
                }
            },
            "options": {
                "timestamps": true,
                "indexes": [
                    { "fields": ["chatId", "createdAt"] },
                    { "unique": true, "fields": ["userId", "clientMsgId"] }
                ]
            }
        },
        {
            "name": "MessengerMessageReads",
            "tableName": "messenger_message_reads",
            "fields": {
                "messageId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "messenger_messages", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_read_message_field" }
                },
                "userId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "users", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_read_user_field" }
                },
                "chatId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "messenger_chats", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_read_chat_field" }
                },
                "deliveredAt": {
                    "type": "DATE",
                    "allowNull": true,
                    "caption": { "i18n": "msg_read_delivered_field" }
                },
                "readAt": {
                    "type": "DATE",
                    "allowNull": true,
                    "caption": { "i18n": "msg_read_read_field" }
                }
            },
            "options": {
                "timestamps": true,
                "indexes": [
                    { "unique": true, "fields": ["messageId", "userId"] },
                    { "fields": ["chatId", "userId", "readAt"] }
                ]
            }
        },
        {
            "//": "Перевод сообщения. Оригинал (messenger_messages.content) НЕ переписывается никогда: перевод — это ещё одно представление того же сообщения, и человек обязан иметь возможность увидеть, что было написано на самом деле. Ключ — сообщение + язык, а не сообщение + получатель: двум получателям с одним языком нужен один перевод.",
            "name": "MessengerMessageTranslations",
            "tableName": "messenger_message_translations",
            "fields": {
                "messageId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "messenger_messages", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_tr_message_field" }
                },
                "userId": {
                    "//": "Автор исходного сообщения — реквизит доступа (как у вложений). Право на переписку даёт участие в чате и проверяется явно (см. requireMember), шлюз отдаёт МЕНЬШЕ, а не больше.",
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "users", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_tr_author_field" }
                },
                "language": {
                    "//": "Код языка ('de', 'ru'), как в таблице translations: перевод принадлежит ЯЗЫКУ, а не записи справочника.",
                    "type": "STRING",
                    "allowNull": false,
                    "caption": { "i18n": "msg_tr_language_field" }
                },
                "content": {
                    "type": "TEXT",
                    "allowNull": true,
                    "caption": { "i18n": "msg_tr_content_field" }
                },
                "engine": {
                    "//": "Чем переведено (модель). Нужно, чтобы отличить перевод старой моделью от нового и не гадать, почему текст изменился.",
                    "type": "STRING",
                    "allowNull": true,
                    "caption": { "i18n": "msg_tr_engine_field" }
                }
            },
            "options": {
                "timestamps": true,
                "indexes": [
                    { "unique": true, "fields": ["messageId", "language"] }
                ]
            }
        },
        {
            "name": "MessengerAttachments",
            "tableName": "messenger_attachments",
            "fields": {
                "messageId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "messenger_messages", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_att_message_field" }
                },
                "userId": {
                    "type": "STRING",
                    "allowNull": false,
                    "references": { "model": "users", "key": "UID" },
                    "onUpdate": "CASCADE",
                    "onDelete": "CASCADE",
                    "caption": { "i18n": "msg_att_owner_field" }
                },
                "name": {
                    "type": "STRING",
                    "allowNull": false,
                    "caption": { "i18n": "msg_att_name_field" }
                },
                "mimeType": {
                    "type": "STRING",
                    "allowNull": false,
                    "caption": { "i18n": "msg_att_mime_field" }
                },
                "size": {
                    "type": "INTEGER",
                    "allowNull": false,
                    "defaultValue": 0,
                    "caption": { "i18n": "msg_att_size_field" }
                },
                "isImage": {
                    "type": "BOOLEAN",
                    "allowNull": false,
                    "defaultValue": false,
                    "caption": { "i18n": "msg_att_is_image_field" }
                },
                "data": {
                    "type": "BLOB",
                    "allowNull": false,
                    "caption": { "i18n": "msg_att_data_field" }
                },
                "thumb": {
                    "type": "BLOB",
                    "allowNull": true,
                    "caption": { "i18n": "msg_att_thumb_field" }
                }
            },
            "options": {
                "timestamps": true,
                "indexes": [
                    { "fields": ["messageId"] }
                ]
            }
        }
    ],
    "associations": [
        {
            "source": "MessengerChats",
            "target": "MessengerChatMembers",
            "type": "hasMany",
            "options": { "foreignKey": "chatId", "as": "members" }
        },
        {
            "source": "MessengerChatMembers",
            "target": "MessengerChats",
            "type": "belongsTo",
            "options": { "foreignKey": "chatId", "as": "chat" }
        },
        {
            "source": "MessengerChats",
            "target": "MessengerMessages",
            "type": "hasMany",
            "options": { "foreignKey": "chatId", "as": "messages" }
        },
        {
            "source": "MessengerMessages",
            "target": "MessengerChats",
            "type": "belongsTo",
            "options": { "foreignKey": "chatId", "as": "chat" }
        },
        {
            "source": "MessengerMessages",
            "target": "MessengerAttachments",
            "type": "hasMany",
            "options": { "foreignKey": "messageId", "as": "attachments" }
        },
        {
            "source": "MessengerAttachments",
            "target": "MessengerMessages",
            "type": "belongsTo",
            "options": { "foreignKey": "messageId", "as": "message" }
        },
        {
            "source": "MessengerMessages",
            "target": "MessengerMessageReads",
            "type": "hasMany",
            "options": { "foreignKey": "messageId", "as": "receipts" }
        },
        {
            "source": "MessengerMessages",
            "target": "MessengerMessageTranslations",
            "type": "hasMany",
            "options": { "foreignKey": "messageId", "as": "translations" }
        },
        {
            "source": "MessengerMessageTranslations",
            "target": "MessengerMessages",
            "type": "belongsTo",
            "options": { "foreignKey": "messageId", "as": "message" }
        },
        {
            "source": "MessengerChatMembers",
            "target": "Users",
            "type": "belongsTo",
            "options": { "foreignKey": "userId", "as": "user" }
        },
        {
            "source": "MessengerMessages",
            "target": "Users",
            "type": "belongsTo",
            "options": { "foreignKey": "userId", "as": "author" }
        }
    ]
}
