[
    {
        "type": "commandBar",
        "extraButtons": [
            {
                "type": "splitButton",
                "name": "btnCreate",
                "caption": {
                    "i18n": "backup_create_now_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/backup.png",
                "menuOnClick": true,
                "menu": [
                    {
                        "caption": {
                            "i18n": "backup_create_full_item"
                        },
                        "icon": "/apps/general_icons/resources/public/16x16/database.png",
                        "events": {
                            "onClick": "createFull"
                        }
                    },
                    {
                        "caption": {
                            "i18n": "backup_create_org_item"
                        },
                        "icon": "/apps/general_icons/resources/public/16x16/organization.png",
                        "events": {
                            "onClick": "createForOrganization"
                        }
                    }
                ]
            },
            {
                "name": "btnCreatePlain",
                "caption": {
                    "i18n": "backup_create_plain_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/download.png",
                "events": {
                    "onClick": "createPlain"
                }
            },
            {
                "name": "btnDownload",
                "caption": {
                    "i18n": "backup_download_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/download.png",
                "events": {
                    "onClick": "downloadSelected"
                },
                "enabledWhen": {
                    "currentRow": "backupFilesTable"
                }
            },
            {
                "name": "btnRestoreOrg",
                "caption": {
                    "i18n": "backup_restore_org_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/restore.png",
                "events": {
                    "onClick": "restoreOrganization"
                },
                "enabledWhen": {
                    "currentRow": "backupFilesTable"
                }
            },
            {
                "name": "btnDeleteFile",
                "caption": {
                    "i18n": "backup_delete_file_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/delete.png",
                "events": {
                    "onClick": "deleteSelected"
                },
                "enabledWhen": {
                    "currentRow": "backupFilesTable"
                }
            },
            {
                "name": "btnSchedule",
                "caption": {
                    "i18n": "backup_schedule_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/clock.png",
                "events": {
                    "onClick": "openSchedule"
                }
            },
            {
                "name": "btnRefreshFiles",
                "caption": {
                    "i18n": "backup_refresh_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/refresh.png",
                "events": {
                    "onClick": "refreshFiles"
                }
            }
        ]
    },
    {
        "type": "tabs",
        "name": "backupTabs",
        "fillHeight": true,
        "tabs": [
            {
                "caption": {
                    "i18n": "backup_tab_work"
                },
                "layout": [
                    {
                        "type": "group",
                        "name": "grpStatus",
                        "caption": {
                            "i18n": "backup_status_group"
                        },
                        "layout": [
                            {
                                "type": "textarea",
                                "name": "statusText",
                                "caption": "",
                                "readOnly": true,
                                "properties": {
                                    "rows": 5
                                },
                                "data": "statusText"
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "name": "grpRun",
                        "caption": {
                            "i18n": "backup_run_group"
                        },
                        "layout": [
                            {
                                "type": "runLog",
                                "name": "runLog",
                                "caption": "",
                                "properties": {
                                    "handler": "backup.create",
                                    "rows": 7
                                }
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "name": "grpFiles",
                        "caption": {
                            "i18n": "backup_files_group"
                        },
                        "layout": [
                            {
                                "type": "table",
                                "name": "backupFilesTable",
                                "data": "backupFiles",
                                "columns": [
                                    {
                                        "caption": {
                                            "i18n": "backup_col_date"
                                        },
                                        "data": "date",
                                        "width": 150,
                                        "inputType": "datetime",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_file"
                                        },
                                        "data": "fileName",
                                        "width": 330,
                                        "inputType": "textbox",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_scope"
                                        },
                                        "data": "scopeType",
                                        "width": 110,
                                        "inputType": "textbox",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_org"
                                        },
                                        "data": "scopeOrganizationName",
                                        "width": 170,
                                        "inputType": "textbox",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_trigger"
                                        },
                                        "data": "triggeredBy",
                                        "width": 110,
                                        "inputType": "textbox",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_rows"
                                        },
                                        "data": "rowsTotal",
                                        "width": 100,
                                        "inputType": "number",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_size"
                                        },
                                        "data": "sizeBytes",
                                        "width": 120,
                                        "inputType": "number",
                                        "readOnly": true
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_col_sha"
                                        },
                                        "data": "sha256",
                                        "autoWidth": true,
                                        "inputType": "textbox",
                                        "readOnly": true
                                    }
                                ],
                                "properties": {
                                    "readOnly": true,
                                    "visibleRows": 10,
                                    "hiddenButtons": [
                                        "recordAdd",
                                        "recordDelete",
                                        "recordOpen",
                                        "listSettings"
                                    ]
                                }
                            }
                        ],
                        "vertical": true
                    }
                ]
            },
            {
                "caption": {
                    "i18n": "backup_tab_settings"
                },
                "layout": [
                    {
                        "type": "group",
                        "name": "grpStorage",
                        "caption": {
                            "i18n": "backup_storage_group"
                        },
                        "alignFields": true,
                        "layout": [
                            {
                                "type": "textbox",
                                "name": "storageDir",
                                "caption": {
                                    "i18n": "backup_storage_dir_field_ro"
                                },
                                "data": "storageDir",
                                "readOnly": true
                            },
                            {
                                "type": "integer",
                                "name": "keepScheduled",
                                "caption": {
                                    "i18n": "backup_keep_scheduled_field"
                                },
                                "properties": {
                                    "width": 90
                                },
                                "data": "keepScheduled"
                            },
                            {
                                "type": "integer",
                                "name": "keepManual",
                                "caption": {
                                    "i18n": "backup_keep_manual_field"
                                },
                                "properties": {
                                    "width": 90
                                },
                                "data": "keepManual"
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "name": "grpScope",
                        "caption": {
                            "i18n": "backup_scope_group"
                        },
                        "alignFields": true,
                        "layout": [
                            {
                                "type": "recordSelector",
                                "name": "scopeOrganizationId",
                                "data": "scopeOrganizationId",
                                "caption": {
                                    "i18n": "backup_scope_org_field"
                                },
                                "properties": {
                                    "selection": {
                                        "table": "organizations",
                                        "idField": "UID",
                                        "displayField": "name"
                                    }
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "caption": {
                    "i18n": "backup_tab_keys"
                },
                "layout": [
                    {
                        "type": "group",
                        "name": "grpKey",
                        "caption": {
                            "i18n": "backup_key_group"
                        },
                        "vertical": true,
                        "layout": [
                            {
                                "type": "group",
                                "name": "grpKeyRow",
                                "noBorder": true,
                                "horizontal": true,
                                "layout": [
                                    {
                                        "type": "textbox",
                                        "name": "keyFingerprint",
                                        "caption": {
                                            "i18n": "backup_key_fingerprint_field"
                                        },
                                        "readOnly": true,
                                        "properties": {
                                            "width": 560
                                        },
                                        "data": "keyFingerprint"
                                    },
                                    {
                                        "type": "button",
                                        "name": "btnGenerateKeys",
                                        "caption": {
                                            "i18n": "backup_generate_keys_btn"
                                        },
                                        "icon": "/apps/general_icons/resources/public/16x16/key.png",
                                        "events": {
                                            "onClick": "generateKeys"
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "textarea",
                                "name": "publicKeyPem",
                                "caption": {
                                    "i18n": "backup_public_key_field"
                                },
                                "properties": {
                                    "rows": 6
                                },
                                "data": "publicKeyPem"
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "name": "grpApi",
                        "caption": {
                            "i18n": "backup_api_group"
                        },
                        "vertical": true,
                        "layout": [
                            {
                                "type": "label",
                                "name": "apiHint",
                                "caption": {
                                    "i18n": "backup_api_hint"
                                }
                            },
                            {
                                "type": "table",
                                "name": "apiClientsTable",
                                "data": "apiClients",
                                "columns": [
                                    {
                                        "caption": {
                                            "i18n": "backup_api_client_name_col"
                                        },
                                        "data": "name",
                                        "width": 200,
                                        "inputType": "textbox"
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_api_client_state_col"
                                        },
                                        "data": "stateText",
                                        "width": 110,
                                        "inputType": "textbox"
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_api_client_seen_col"
                                        },
                                        "data": "lastSeenText",
                                        "width": 190,
                                        "inputType": "textbox"
                                    },
                                    {
                                        "caption": {
                                            "i18n": "backup_api_client_fp_col"
                                        },
                                        "data": "fingerprint",
                                        "autoWidth": true,
                                        "inputType": "textbox"
                                    }
                                ],
                                "properties": {
                                    "readOnly": true,
                                    "visibleRows": 4,
                                    "hiddenButtons": [
                                        "recordAdd",
                                        "recordDelete",
                                        "recordOpen",
                                        "listSettings"
                                    ]
                                }
                            },
                            {
                                "type": "group",
                                "name": "grpApiSelectionRow",
                                "noBorder": true,
                                "horizontal": true,
                                "layout": [
                                    {
                                        "type": "button",
                                        "name": "btnApiToggle",
                                        "caption": {
                                            "i18n": "backup_api_toggle_btn"
                                        },
                                        "icon": "/apps/general_icons/resources/public/16x16/cancel.png",
                                        "events": {
                                            "onClick": "toggleApiClient"
                                        },
                                        "enabledWhen": {
                                            "currentRow": "apiClientsTable"
                                        }
                                    },
                                    {
                                        "type": "button",
                                        "name": "btnApiRemove",
                                        "caption": {
                                            "i18n": "backup_api_remove_btn"
                                        },
                                        "icon": "/apps/general_icons/resources/public/16x16/delete.png",
                                        "events": {
                                            "onClick": "removeApiClient"
                                        },
                                        "enabledWhen": {
                                            "currentRow": "apiClientsTable"
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "group",
                                "name": "grpApiRegister",
                                "caption": {
                                    "i18n": "backup_api_register_group"
                                },
                                "vertical": true,
                                "layout": [
                                    {
                                        "type": "textarea",
                                        "name": "apiClientKeyPem",
                                        "caption": {
                                            "i18n": "backup_api_new_key_field"
                                        },
                                        "properties": {
                                            "rows": 4
                                        },
                                        "data": "apiClientKeyPem"
                                    },
                                    {
                                        "type": "group",
                                        "name": "grpApiRow",
                                        "noBorder": true,
                                        "horizontal": true,
                                        "layout": [
                                            {
                                                "type": "textbox",
                                                "name": "apiClientName",
                                                "caption": {
                                                    "i18n": "backup_api_new_name_field"
                                                },
                                                "properties": {
                                                    "width": 220
                                                },
                                                "data": "apiClientName"
                                            },
                                            {
                                                "type": "button",
                                                "name": "btnApiAdd",
                                                "caption": {
                                                    "i18n": "backup_api_add_btn"
                                                },
                                                "icon": "/apps/general_icons/resources/public/16x16/add.png",
                                                "events": {
                                                    "onClick": "addApiClient"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "group",
                        "name": "grpRecovery",
                        "caption": {
                            "i18n": "backup_recovery_group"
                        },
                        "vertical": true,
                        "layout": [
                            {
                                "type": "label",
                                "name": "recoveryHint",
                                "caption": {
                                    "i18n": "backup_recovery_hint"
                                }
                            },
                            {
                                "type": "group",
                                "name": "grpRecoveryRow",
                                "noBorder": true,
                                "horizontal": true,
                                "layout": [
                                    {
                                        "type": "textbox",
                                        "name": "recoveryState",
                                        "caption": {
                                            "i18n": "backup_recovery_state_field"
                                        },
                                        "readOnly": true,
                                        "data": "recoveryState"
                                    },
                                    {
                                        "type": "textbox",
                                        "name": "recoveryPassword",
                                        "caption": {
                                            "i18n": "backup_recovery_password_field"
                                        },
                                        "data": "recoveryPassword"
                                    },
                                    {
                                        "type": "button",
                                        "name": "btnSetRecovery",
                                        "caption": {
                                            "i18n": "backup_recovery_set_btn"
                                        },
                                        "icon": "/apps/general_icons/resources/public/16x16/key.png",
                                        "events": {
                                            "onClick": "setRecoveryPassword"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
