[
    {
        "type": "commandBar",
        "hiddenButtons": [
            "ok",
            "save"
        ],
        "extraButtons": [
            {
                "name": "btnPickFile",
                "caption": {
                    "i18n": "restore_full_upload_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/open.png",
                "events": {
                    "onClick": "pickFile"
                }
            },
            {
                "name": "btnInspect",
                "caption": {
                    "i18n": "restore_full_inspect_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/preview.png",
                "events": {
                    "onClick": "inspectFile"
                }
            },
            {
                "name": "btnRestore",
                "caption": {
                    "i18n": "restore_full_run_btn"
                },
                "icon": "/apps/general_icons/resources/public/16x16/restore.png",
                "enabled": false,
                "events": {
                    "onClick": "runFullRestore"
                }
            }
        ]
    },
    {
        "type": "group",
        "name": "grpReady",
        "orientation": "vertical",
        "noBorder": true,
        "layout": [
            {
                "type": "textbox",
                "name": "runState",
                "data": "runState",
                "readOnly": true,
                "caption": {
                    "i18n": "restore_full_ready_field"
                }
            }
        ]
    },
    {
        "type": "group",
        "name": "grpSource",
        "orientation": "vertical",
        "caption": {
            "i18n": "restore_full_source_group"
        },
        "alignFields": true,
        "layout": [
            {
                "type": "recordSelector",
                "name": "fileUID",
                "data": "fileUID",
                "caption": {
                    "i18n": "restore_full_file_field"
                },
                "properties": {
                    "selection": {
                        "table": "backup_files",
                        "idField": "UID",
                        "displayField": "fileName"
                    }
                }
            },
            {
                "type": "textbox",
                "name": "uploadName",
                "data": "uploadName",
                "readOnly": true,
                "caption": {
                    "i18n": "restore_full_uploaded_field"
                }
            },
            {
                "type": "textbox",
                "name": "modeInfo",
                "data": "modeInfo",
                "readOnly": true,
                "caption": {
                    "i18n": "restore_full_mode_field"
                }
            }
        ]
    },
    {
        "type": "group",
        "name": "grpScope",
        "orientation": "vertical",
        "caption": {
            "i18n": "restore_scope_group"
        },
        "alignFields": true,
        "layout": [
            {
                "type": "emunList",
                "name": "restoreScope",
                "data": "restoreScope",
                "caption": {
                    "i18n": "restore_scope_field"
                },
                "options": [
                    {
                        "value": "full",
                        "caption": {
                            "i18n": "restore_scope_full"
                        }
                    },
                    {
                        "value": "organization",
                        "caption": {
                            "i18n": "restore_scope_org"
                        }
                    }
                ],
                "events": {
                    "onChange": "scopeChanged"
                }
            },
            {
                "type": "recordSelector",
                "name": "organizationId",
                "data": "organizationId",
                "caption": {
                    "i18n": "restore_target_org_field"
                },
                "properties": {
                    "selection": {
                        "table": "organizations",
                        "idField": "UID",
                        "displayField": "name"
                    }
                }
            }
        ]
    },
    {
        "type": "group",
        "name": "grpReport",
        "orientation": "vertical",
        "caption": {
            "i18n": "restore_full_report_group"
        },
        "layout": [
            {
                "type": "textarea",
                "name": "reportText",
                "caption": "",
                "readOnly": true,
                "properties": {
                    "rows": 12
                },
                "data": "reportText"
            }
        ]
    },
    {
        "type": "group",
        "name": "grpPassword",
        "orientation": "vertical",
        "caption": {
            "i18n": "restore_full_password_group"
        },
        "layout": [
            {
                "type": "label",
                "name": "pwdWarning",
                "caption": {
                    "i18n": "restore_full_password_warning"
                }
            },
            {
                "type": "group",
                "name": "grpPwdFields",
                "orientation": "vertical",
                "noBorder": true,
                "alignFields": true,
                "layout": [
                    {
                        "type": "textbox",
                        "name": "passwordState",
                        "data": "passwordState",
                        "readOnly": true,
                        "caption": {
                            "i18n": "restore_full_pwd_state_field"
                        }
                    },
                    {
                        "type": "textbox",
                        "name": "recoveryPassword",
                        "data": "recoveryPassword",
                        "caption": {
                            "i18n": "restore_full_pwd_field"
                        }
                    }
                ]
            },
            {
                "type": "group",
                "name": "grpPwdButtons",
                "orientation": "horizontal",
                "noBorder": true,
                "layout": [
                    {
                        "type": "button",
                        "name": "btnVerifyPwd",
                        "caption": {
                            "i18n": "restore_full_pwd_verify_btn"
                        },
                        "icon": "/apps/general_icons/resources/public/16x16/select.png",
                        "events": {
                            "onClick": "verifyRecoveryPassword"
                        }
                    },
                    {
                        "type": "button",
                        "name": "btnGeneratePwd",
                        "caption": {
                            "i18n": "restore_full_pwd_generate_btn"
                        },
                        "icon": "/apps/general_icons/resources/public/16x16/key.png",
                        "events": {
                            "onClick": "generateRecoveryPassword"
                        }
                    }
                ]
            }
        ]
    },
    {
        "type": "group",
        "name": "grpKey",
        "orientation": "vertical",
        "caption": {
            "i18n": "restore_key_group"
        },
        "layout": [
            {
                "type": "label",
                "name": "keyHint",
                "caption": {
                    "i18n": "restore_key_hint"
                }
            },
            {
                "type": "group",
                "name": "grpKeyRow",
                "orientation": "horizontal",
                "noBorder": true,
                "layout": [
                    {
                        "type": "button",
                        "name": "btnPickKey",
                        "caption": {
                            "i18n": "restore_key_pick_btn"
                        },
                        "icon": "/apps/general_icons/resources/public/16x16/key.png",
                        "events": {
                            "onClick": "pickKeyFile"
                        }
                    },
                    {
                        "type": "textbox",
                        "name": "keyState",
                        "data": "keyState",
                        "readOnly": true,
                        "caption": {
                            "i18n": "restore_key_state_field"
                        }
                    }
                ]
            }
        ]
    },
    {
        "type": "runLog",
        "name": "runLog",
        "properties": {
            "handler": "restore.full",
            "rows": 7
        }
    }
]